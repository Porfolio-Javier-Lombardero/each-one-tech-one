# Supabase — credenciales del cliente
# La anon key es pública por diseño: la seguridad la dan las RLS policies del proyecto.
# Copia este archivo a .env y rellena con los valores de tu proyecto de Supabase.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_publica
